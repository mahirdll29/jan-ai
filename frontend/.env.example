# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; .env.example is committed as documentation so anyone
# cloning the repo knows which variables the frontend needs.
#
# ---- A NOTE ON THE NEXT_PUBLIC_ PREFIX -------------------------------------
#
# Next.js only exposes environment variables to BROWSER code if their name
# begins with NEXT_PUBLIC_. Everything without that prefix stays server-side.
#
# The prefix is a deliberate opt-in, and it is a warning label: anything carrying
# it is inlined into the JavaScript bundle at build time and is readable by
# anyone who opens devtools. It is not a secret and cannot be made one.
#
# This is why the backend — not the frontend — holds JWT_SECRET, DATABASE_URL and
# GROQ_API_KEY. Those must never appear in this file under any name.

# Origin of the Express backend. No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:5000

# ---- Cloudinary (Phase 4) — unsigned direct-from-browser upload ----
#
# Create the preset at: Cloudinary → Settings → Upload → Upload presets → Add
# with SIGNING MODE: UNSIGNED.
#
# NEITHER OF THESE IS A SECRET. An unsigned upload authenticates with the cloud
# name and preset name alone, and both are compiled into the client bundle by
# design. Your Cloudinary API KEY and API SECRET are server-side credentials —
# they are not needed here and must never be given a NEXT_PUBLIC_ prefix.
#
# The accepted v1 tradeoff: because the preset is public, anyone reading the
# bundle can upload to this account. Bound it in the preset's own settings —
# restrict the folder, the allowed formats and the max file size. Those are the
# real controls; the client-side checks are only UX.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# ---- Map (Phase 5) — nothing to configure ----
#
# The map uses Leaflet with OpenStreetMap tiles, which need no account, no API
# key and no environment variable. That was a large part of choosing it over
# Mapbox, which would have required a token in every environment plus a
# degradation path for when it is missing or over quota.
#
# There is deliberately no NEXT_PUBLIC_MAPBOX_TOKEN here.
