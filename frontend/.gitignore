# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but .env.example carries no secrets and is committed ON PURPOSE, as
# documentation of which variables the app needs. Next's default `.env*` would
# have swallowed it, which is how a repo ends up cloneable but unrunnable.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
