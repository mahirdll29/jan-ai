# Copy this file to .env and fill in real values.
# .env is gitignored — .env.example is committed as documentation so anyone
# cloning the repo knows which environment variables the app needs.

# PostgreSQL connection string (Neon).
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# --- Added in Module 2 (Auth) ---

# Port the Express server listens on.
PORT=5000

# Origin of the frontend, used by CORS. Must be an exact origin with no trailing
# slash, because "*" is illegal once credentials are enabled.
FRONTEND_URL=http://localhost:3000

# "development" or "production". Controls the cookie's secure/sameSite flags.
NODE_ENV=development

# Secret used to sign and verify JWTs. Anyone who has this can forge a token for
# any user, so it must never be committed. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"

# --- Added in Module 4 (AI pipeline) ---

# Groq API key. Server-side only — it is never sent to the browser, because
# anyone holding it can spend money against this account.
GROQ_API_KEY=gsk_your_groq_api_key

# The Groq model id. Lives here rather than in code because a model name changes
# far more often than the code that calls it — Groq deprecates and retires models
# regularly. Swapping models is then a config change and a restart, not a code
# edit, review and redeploy. Verified active on 2026-08-13 via
#   GET https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-20b
